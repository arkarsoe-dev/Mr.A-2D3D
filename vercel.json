{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "functions": {
    "api/ai-chat.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/live-2d",
      "dest": "https://api.thaistock2d.com/live"
    },
    {
      "src": "/api/threed-result",
      "dest": "https://api.2dboss.com/api/v2/v1/2dstock/threed-result"
    },
    {
      "src": "/api/ai-chat",
      "dest": "/api/ai-chat.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
